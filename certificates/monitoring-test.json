{
  "rule_files": [
    "monitoring-rules.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "healthy",
      "interval": "1m",
      "input_series": [
        {
          "series": "homelab_certificate_renewal_success",
          "values": "1+0x10"
        },
        {
          "series": "homelab_certificate_renewal_last_success_seconds",
          "values": "0+60x10"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "10m",
          "alertname": "CertificateRenewalFailed",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "failed",
      "interval": "1m",
      "input_series": [
        {
          "series": "homelab_certificate_renewal_success",
          "values": "0+0x10"
        },
        {
          "series": "homelab_certificate_renewal_last_success_seconds",
          "values": "0+60x10"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "10m",
          "alertname": "CertificateRenewalFailed",
          "exp_alerts": [
            {
              "exp_labels": {},
              "exp_annotations": {}
            }
          ]
        }
      ]
    },
    {
      "name": "recovered",
      "interval": "1m",
      "input_series": [
        {
          "series": "homelab_certificate_renewal_success",
          "values": "0+0x5 1+0x5"
        },
        {
          "series": "homelab_certificate_renewal_last_success_seconds",
          "values": "0+60x11"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "10m",
          "alertname": "CertificateRenewalFailed",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "stale",
      "interval": "1m",
      "input_series": [
        {
          "series": "homelab_certificate_renewal_last_success_seconds",
          "values": "-140000+0x10"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "10m",
          "alertname": "CertificateRenewalStale",
          "exp_alerts": [
            {
              "exp_labels": {},
              "exp_annotations": {}
            }
          ]
        }
      ]
    },
    {
      "name": "missing",
      "interval": "1m",
      "input_series": [],
      "alert_rule_test": [
        {
          "eval_time": "10m",
          "alertname": "CertificateRenewalStale",
          "exp_alerts": [
            {
              "exp_labels": {},
              "exp_annotations": {}
            }
          ]
        }
      ]
    }
  ]
}
