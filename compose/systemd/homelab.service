[Unit]
Description=Homelab Compose stack
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
RequiresMountsFor=/opt/data /mnt/media-library

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/data/homelab
ExecStartPre=/usr/bin/mountpoint -q /opt/data
ExecStartPre=/usr/bin/mountpoint -q /mnt/media-library
ExecStart=/usr/bin/docker compose -f compose.yaml -f compose.proxy.yaml up -d
ExecStop=/usr/bin/docker compose -f compose.yaml -f compose.proxy.yaml stop
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
