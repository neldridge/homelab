          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "NAS DSM / Storage Manager",
          "url": "https://192.168.11.131:5001/",
          "targetBlank": true
        },
        {
          "title": "Alert rules and time-bounded silences",
          "url": "https://grafana.neldridge.net:3000/alerting/list",
          "targetBlank": true
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 34,
      "title": "Scheduled backup artifact age (days)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 112,
        "w": 24,
