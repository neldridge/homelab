    {
      "id": 37,
      "title": "NAS volume and USB free capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 136,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(hrStorageSize{job=\"synology\",hrStorageDescr=~\"/volume2|/volumeUSB1/usbshare\"} - hrStorageUsed{job=\"synology\"}) * hrStorageAllocationUnits{job=\"synology\"}",
          "legendFormat": "{{__name__}} {{diskID}} {{raidName}} {{hrStorageDescr}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "links": [
        {
          "title": "NAS DSM / Storage Manager",
          "url": "https://192.168.11.131:5001/",
          "targetBlank": true
        },
        {
          "title": "Alert rules and time-bounded silences",
          "url": "https://grafana.neldridge.net:3000/alerting/list",
          "targetBlank": true
        },
        {
          "title": "SNMP collector logs",
          "url": "https://grafana.neldridge.net:3000/d/homelab-overview?var-service=monitoring-snmp&viewPanel=24",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 40,
      "title": "Installed images/application versions vs available stable releases (daily snapshot)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 144,
        "w": 24,
        "h": 14
      },
      "description": "Daily read-only snapshot. Running digest is the local RepoDigest; image_id is the running platform config digest. Available digest is the registry index, compared via the matching platform config. Stable only, no automatic upgrades. unknown means lookup failed. Image tag is not the application version; source states API, run-log, HTTP header, build metric or immutable image label. Plex architecture unavailable via its current API. Seerr uses the official stable image and a separately migrated configuration; the untouched Overseerr configuration is retained for rollback.",
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_version_info",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true
            },
            "indexByName": {
              "service": 0,
              "installed_version": 1,
              "version_source": 2,
              "installed_tag": 3,
              "available_tag": 4,
              "status": 5,
              "channel": 6,
              "architecture": 7,
              "image": 8,
              "running_digest": 9,
              "image_id": 10,
              "available_digest": 11,
              "installed_channel": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "service",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 41,
      "title": "Last daily version check",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 158,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_version_checked_timestamp * 1000",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal"
        },
        "overrides": []
      }
    },
    {
      "id": 42,
      "title": "Version maintenance notes",
      "type": "text",
      "gridPos": {
        "x": 8,
        "y": 158,
        "w": 16,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Stable updates and lookup gaps use **informational PagerDuty** with recovery, grouped by alert name and host; reminders every seven days are not a weekly digest. Seerr migration is verified; Overseerr configuration and the private pre-migration archive remain available for rollback. No migration or upgrades are automated. Public Plex releases only; beta/channel and external server architecture remain unverified. Inspect snapshot time before acting."
      }
    },
    {
      "id": 60,
      "title": "Local / NAS recovery stage evidence (0 = unknown, 1 = verified success, -1 = failed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 162,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(homelab_recovery_success{stage=~\"local|nas\"} * 2 - 1) * homelab_recovery_known{stage=~\"local|nas\"}",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Local creation and verified NAS publication are monitored here. Cloud backups are monitored by Synology DSM Hyper Backup notifications; no automatic cloud status collection is configured."
    },
    {
      "id": 61,
      "title": "Local / NAS recovery stage completion age (unknown stages omitted)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 162,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((time() - homelab_recovery_completed_timestamp{stage=~\"local|nas\"}) / 3600) and (homelab_recovery_known{stage=~\"local|nas\"} == 1)",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Local creation and verified NAS publication are monitored here. Cloud backups are monitored by Synology DSM Hyper Backup notifications; no automatic cloud status collection is configured."
    }
  ],
  "links": [
    {
      "title": "Alerts and time-bounded silences",
      "url": "/alerting/list"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "sonarr,radarr,prowlarr,bazarr,seerr,nzbget,tautulli,nginx,kometa,host,canary,monitoring-loki,monitoring-alloy,monitoring-grafana,monitoring-prometheus,monitoring-blackbox,monitoring-snmp",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      }
    ]
  }
}
